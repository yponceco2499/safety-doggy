{
  "expo": {
    "name": "SafetyPet",
    "slug": "safetydoggy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safetydoggy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "app.safetypet",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SafetyPet utilise votre position pour centrer la carte et pré-remplir vos signalements. Si vous activez le suivi de distance sur une sortie, elle est aussi utilisée en arrière-plan le temps de la sortie pour calculer la distance parcourue.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SafetyPet utilise vos photos pour illustrer un signalement (optionnel).",
          "cameraPermission": "SafetyPet utilise l'appareil photo pour illustrer un signalement (optionnel)."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "980aa890-e033-43a9-8d62-ec9a50987fda"
      }
    },
    "owner": "safetydoggys-team"
  }
}
